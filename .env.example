PORT=3000
HOST=127.0.0.1
# sqlite permite probar el proyecto sin instalar MySQL. Para MySQL cambia DB_DRIVER.
DB_DRIVER=sqlite
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=saloney
MYSQL_PASSWORD=cambia_esta_clave
MYSQL_DATABASE=saloney
# Las cuentas de ejemplo solo se crean en modo demostración.
DEMO_SEED=true
# En producción: DEMO_SEED=false, NODE_ENV=production y HTTPS.
NODE_ENV=development

# Opcional. Configura estas variables en el servidor para activar WhatsApp.
# Número remitente en formato internacional, por ejemplo +57 seguido del número.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=
TWILIO_REMINDER_CONTENT_SID=
